{
  "name": "booru-suite",
  "version": "1.0.1",
  "description": "Booru Tagger + Eagle Toolkit in one app: GPU tagging, renaming, tag merging and duplicate-proof Eagle sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.booru.suite",
    "productName": "Booru Suite",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**"
    ],
    "extraResources": [
      { "from": "worker", "to": "worker" }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}
